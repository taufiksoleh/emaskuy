# Newsletter signup (optional). Copy to .env.local for local testing; in
# production set the GitHub repository variables NEWSLETTER_ACTION,
# NEWSLETTER_EMAIL_FIELD and NEWSLETTER_EXTRA (Settings → Secrets and
# variables → Actions → Variables). Without an action URL the signup form is
# hidden.
#
# Take the values from your provider's "embedded form" HTML: the <form
# action="…"> URL and the name="…" of the email input. Turn ON double opt-in
# and turn OFF captcha for that form.
#
#   Buttondown:  action https://buttondown.com/api/emails/embed-subscribe/<username>
#                field  email
#   Kit:         action https://app.kit.com/forms/<form-id>/subscriptions
#                field  email_address
#   MailerLite:  action https://assets.mailerlite.com/jsonp/<account>/forms/<form-id>/subscribe
#                field  fields[email]
#                extra  ml-submit=1&anticsrf=true
VITE_NEWSLETTER_ACTION=
VITE_NEWSLETTER_EMAIL_FIELD=email
VITE_NEWSLETTER_EXTRA=

# Cloudflare Web Analytics (optional, no cookies). Repository variable:
# CF_BEACON_TOKEN. Without it no analytics script is added.
VITE_CF_BEACON_TOKEN=
